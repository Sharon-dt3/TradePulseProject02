# Copy to .env locally or configure these values in the producer service's
# secret environment. Never commit a real POLYGON_API_KEY.
POLYGON_API_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional endpoint overrides. Defaults use Massive's current provider hosts.
# POLYGON_REST_BASE_URL=https://api.massive.com
# POLYGON_STOCKS_WS_URL=wss://socket.massive.com/stocks
# POLYGON_CRYPTO_WS_URL=wss://socket.massive.com/crypto
# POLYGON_BACKFILL_MINUTES=60

# Run the stock producer by default. Start a second producer with
# POLYGON_FEED=crypto if continuous BTCUSD updates are also needed.
# POLYGON_FEED=stocks
