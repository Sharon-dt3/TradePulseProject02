# Copy to .env locally or configure these values in the producer service's
# secret environment. Never commit a real API key.
#
# Create a free key at https://finnhub.io/register. It is used only for
# AAPL, MSFT, GOOGL, and TSLA. BTCUSD uses Coinbase's public feed and needs
# no credential.
FINNHUB_API_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379

# The default free_tier_producer.py requires no further configuration.
# It publishes Finnhub equity trades and Coinbase BTC-USD ticker updates to
# the same internal Redis market.ticks stream consumed by TradePulse.
