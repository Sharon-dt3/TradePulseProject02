aws_region       = "us-east-1"
project_name     = "tradepulse"
environment      = "production"
dashboard_domain = "tradepulse.example.com"
route53_zone_id  = "Z0123456789EXAMPLE"

# Use immutable ECR image tags or digests produced by your CI pipeline.
dashboard_image     = "123456789012.dkr.ecr.us-east-1.amazonaws.com/tradepulse-dashboard:git-sha"
ledger_core_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/tradepulse-ledger-core:git-sha"
risk_engine_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/tradepulse-risk-engine:git-sha"
gateway_image       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/tradepulse-gateway:git-sha"
tick_producer_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/tradepulse-tick-producer:git-sha"

# Existing AWS Secrets Manager ARNs. Do not place their values in Terraform.
supabase_runtime_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:tradepulse/production/supabase"
finnhub_secret_arn          = "arn:aws:secretsmanager:us-east-1:123456789012:secret:tradepulse/production/finnhub"
