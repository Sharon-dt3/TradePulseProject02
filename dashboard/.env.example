# Public Supabase browser configuration. Obtain these values from Supabase
# Dashboard -> Project Settings -> API. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# These are optional. `npm run dev` defaults to the local service ports below;
# production keeps them empty so AWS ALB same-origin routing is used.
# NEXT_PUBLIC_LEDGER_CORE_URL=http://localhost:8080
# NEXT_PUBLIC_RISK_ENGINE_URL=http://localhost:8001
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8081

# Set to true only for a clearly labeled, dashboard-only equity movement demo.
# Simulated values never enter Redis or affect orders, positions, portfolio
# totals, or risk calculations.
NEXT_PUBLIC_DEMO_EQUITY_PRICES=false
